[Unit]
Description=Content Viewer allowlisted development-image auto-update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
TimeoutStopSec=2min
WorkingDirectory=%h/content-viewer
Environment=HOME=%h
# Lingering user managers on EL8 often have only the primary group. sg docker
# enters the allowlisted socket group; NoNewPrivileges would block that.
ExecStart=/usr/bin/sg docker -c '%h/content-viewer/infra/docker/autoupdate.sh --config %h/.config/content-viewer/autoupdate.conf --once'
PrivateTmp=true
UMask=0077
