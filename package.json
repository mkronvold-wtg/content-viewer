{
  "name": "content-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "theme:update": "node scripts/update-theme.mjs",
    "build": "npm run check",
