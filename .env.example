PORT=8080
HOST=0.0.0.0

# Generic clone settings retained for compatibility.
CONTENT_VIEWER_REPO_PATH=/app/content
CONTENT_VIEWER_REPO_URL=https://github.com/OWNER/CONTENT_REPO.git
CONTENT_VIEWER_REPO_BRANCH=main

# Multi-repository mode: CONTENT_VIEWER_REPOS is the ordered slug list. Each
# slug becomes a URL prefix and needs PATH, URL, BRANCH, and repository-relative
# BASE_DIR settings. The BASE_DIR value scopes intended document content; leading
# and trailing / are normalized. Per-repo suffixes are the slug uppercased with
# punctuation changed to _, so kpe.content becomes KPE_CONTENT.
CONTENT_VIEWER_REPOS=kpe.content,team.docs
CONTENT_VIEWER_REPO_KPE_CONTENT_PATH=/app/content/kpe.content
CONTENT_VIEWER_REPO_KPE_CONTENT_URL=https://github.com/OWNER/kpe-content.git
CONTENT_VIEWER_REPO_KPE_CONTENT_BRANCH=main
CONTENT_VIEWER_REPO_KPE_CONTENT_BASE_DIR=/data/
CONTENT_VIEWER_REPO_TEAM_DOCS_PATH=/app/content/team.docs
CONTENT_VIEWER_REPO_TEAM_DOCS_URL=https://github.com/OWNER/team-docs.git
CONTENT_VIEWER_REPO_TEAM_DOCS_BRANCH=main
CONTENT_VIEWER_REPO_TEAM_DOCS_BASE_DIR=/docs/

# Required for private GitHub content repos.
# Use a read-only fine-grained token with Contents: read on the content repo.
CONTENT_VIEWER_GITHUB_TOKEN=replace_with_read_only_token

# Optional scheduled pull/index refresh. The Refresh button also pulls on demand.
# CONTENT_VIEWER_REFRESH_INTERVAL_SECONDS=300
